# Connexion serveur à Nest. Aucune URL de base de données ici.
BACKEND_URL=http://localhost:4000
# URL publique uniquement après déploiement ; les préversions restent non indexables.
# NEXT_PUBLIC_SITE_URL=https://gaindesportif.sn
NEXT_PUBLIC_ALLOW_INDEXING=false
# Secret serveur partagé avec Nest (jamais NEXT_PUBLIC_).
# CONTACT_PROXY_SECRET=generate_a_random_secret_of_at_least_32_characters
# Header IP obligatoirement réécrit par le proxy de confiance. Ne pas activer sur un port Node public.
# CONTACT_IP_HEADER=x-forwarded-for
